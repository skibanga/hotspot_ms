 "doctype": "Print Format",
 "font_size": 11,
 "html": "<div style=\"border:1px solid #222;border-radius:8px;padding:12px;font-family:Arial,sans-serif;max-width:360px;\">\n  <h3 style=\"margin:0 0 6px;\">Hotspot Voucher</h3>\n  <p style=\"margin:0 0 10px;color:#555;\">Keep this code secure. One-time sale card.</p>\n  <div style=\"font-size:20px;font-weight:bold;letter-spacing:1px;border:1px dashed #777;padding:8px;text-align:center;margin-bottom:10px;\">{{ doc.voucher_code }}</div>\n  <table style=\"width:100%;font-size:12px;border-collapse:collapse;\">\n    <tr><td style=\"padding:3px 0;color:#666;\">Plan</td><td style=\"padding:3px 0;text-align:right;\">{{ doc.plan }}</td></tr>\n    <tr><td style=\"padding:3px 0;color:#666;\">Status</td><td style=\"padding:3px 0;text-align:right;\">{{ doc.status }}</td></tr>\n    <tr><td style=\"padding:3px 0;color:#666;\">Expires</td><td style=\"padding:3px 0;text-align:right;\">{{ frappe.format(doc.expires_on, {\"fieldtype\":\"Datetime\"}) if doc.expires_on else \"Per plan\" }}</td></tr>\n    <tr><td style=\"padding:3px 0;color:#666;\">Data Limit</td><td style=\"padding:3px 0;text-align:right;\">{{ doc.data_limit_mb if doc.data_limit_mb else \"Unlimited\" }}{% if doc.data_limit_mb %} MB{% endif %}</td></tr>\n  </table>\n  <hr style=\"margin:10px 0;\">\n  <small style=\"color:#666;\">Portal: /hotspot/login</small>\n</div>",
 "line_breaks": 0,
 "margin_bottom": 12.7,
